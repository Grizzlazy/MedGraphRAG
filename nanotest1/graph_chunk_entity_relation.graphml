  <data key="d2">chunk-01a8df0641b60633d561ef3970a93bd8</data>
</node>
<node id="&quot;VASCULAR INTENSIVE CARE UNIT&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"A specialized hospital department where the patient was initially admitted for hypotension and decreased urine output."&lt;SEP&gt;"A specialized unit where the patient was initially admitted for cardiovascular and septic instability."</data>
  <data key="d2">chunk-d5608bdb3aa5a25b6c0f796f152462c2</data>
</node>
<node id="&quot;MEDICAL INTENSIVE CARE UNIT&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"A critical care unit where the patient boarded for stabilization before arrest and subsequent recovery."&lt;SEP&gt;"A critical care unit where the patient experienced a cardiorespiratory arrest and received resuscitation measures."</data>
