<node id="&quot;SPUTUM CULTURE&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"A diagnostic procedure event showing initial pending results with subsequent yeast growth."&lt;SEP&gt;"Sputum Culture is a diagnostic test taken on admission which also grew yeasts."</data>
  <data key="d2">chunk-d5608bdb3aa5a25b6c0f796f152462c2&lt;SEP&gt;chunk-01a8df0641b60633d561ef3970a93bd8</data>
