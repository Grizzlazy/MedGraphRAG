<node id="&quot;URINE CULTURE&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"A diagnostic procedure event detecting growth of yeast after initial pending results."&lt;SEP&gt;"Urine Culture is a diagnostic test taken on admission that ultimately grew yeast."</data>
  <data key="d2">chunk-d5608bdb3aa5a25b6c0f796f152462c2&lt;SEP&gt;chunk-01a8df0641b60633d561ef3970a93bd8</data>
