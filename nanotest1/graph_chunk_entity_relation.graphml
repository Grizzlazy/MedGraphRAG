  <data key="d0">"EVENT"</data>
  <data key="d1">"The event where the patient was moved from the intensive care unit to general medicine upon volume overload resolution."</data>
  <data key="d2">chunk-d5608bdb3aa5a25b6c0f796f152462c2</data>
</node>
<node id="&quot;DISCHARGE TO REHABILITATION&quot;">
