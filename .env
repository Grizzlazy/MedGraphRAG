NEO4J_URL=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=medgraphrag2026

# ── LLM endpoint — vLLM (port 8101) ──────────────────────────────────────────
# vLLM chạy riêng, xử lý nhiều request song song (max-num-seqs)
OPENAI_API_BASE_URL=http://localhost:8101/v1
OPENAI_API_KEY=EMPTY
LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
LLM_CHEAP_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ── Embedding endpoint — Ollama (port 11434) ──────────────────────────────────
# nomic-embed-text rất nhỏ (~274MB), Ollama chạy song song vLLM được
# Nếu không dùng Ollama, comment 3 dòng dưới → embedding cũng dùng vLLM
EMBEDDING_API_BASE_URL=http://localhost:8102/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIM=768
EMBEDDING_MAX_TOKENS=8192

# ── HTTP connection pool ───────────────────────────────────────────────────────
OPENAI_MAX_CONNECTIONS=200
OPENAI_MAX_KEEPALIVE=80

# ── HTTP timeouts (giây) ──────────────────────────────────────────────────────
OPENAI_CONNECT_TIMEOUT=60
OPENAI_READ_TIMEOUT=600
OPENAI_WRITE_TIMEOUT=120
OPENAI_POOL_TIMEOUT=60
