<node id="&quot;FOOT ULCERS&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Chronic nonhealing foot ulcers were a significant wound complication managed during hospitalization."&lt;SEP&gt;"The chronic medical event of nonhealing foot ulcers in the patient's history."</data>
  <data key="d2">chunk-01a8df0641b60633d561ef3970a93bd8&lt;SEP&gt;chunk-87d9cef9bf2900e79467061ad5003a41</data>
