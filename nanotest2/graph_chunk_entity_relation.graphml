  <data key="d0">"EVENT"</data>
  <data key="d1">"Alzheimer's dementia was a neurological condition noted in the patient's discharge diagnoses."&lt;SEP&gt;"The diagnosed medical event of Alzheimer's dementia in the patient's past medical history."</data>
  <data key="d2">chunk-01a8df0641b60633d561ef3970a93bd8&lt;SEP&gt;chunk-87d9cef9bf2900e79467061ad5003a41</data>
