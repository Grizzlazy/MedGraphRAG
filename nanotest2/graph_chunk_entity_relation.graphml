<node id="&quot;DISCHARGE&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Discharge marks the specific event of the patient leaving the hospital."&lt;SEP&gt;"The event of the patient leaving the hospital after volume overload resolved with adequate diuresis."&lt;SEP&gt;"The medical event of moving the patient from the hospital to a rehabilitation facility."</data>
  <data key="d2">chunk-d5608bdb3aa5a25b6c0f796f152462c2&lt;SEP&gt;chunk-01a8df0641b60633d561ef3970a93bd8&lt;SEP&gt;chunk-87d9cef9bf2900e79467061ad5003a41</data>
</node>
