  <data key="d2">chunk-87d9cef9bf2900e79467061ad5003a41</data>
</node>
<node id="&quot;HEPARIN&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Heparin was a discharge medication prescribed at 5000 units subcutaneously twice daily."</data>
  <data key="d2">chunk-87d9cef9bf2900e79467061ad5003a41</data>
</node>
<node id="&quot;EPTIFIBATIDE&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Eptifibatide was a medication associated with the patient's history of gastrointestinal bleed."</data>
  <data key="d2">chunk-87d9cef9bf2900e79467061ad5003a41</data>
</node>
<node id="&quot;CORONARY ARTERY DISEASE&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Coronary artery disease with diffuse 3-vessel disease was a major discharge diagnosis for the patient."</data>
  <data key="d2">chunk-87d9cef9bf2900e79467061ad5003a41</data>
</node>
<node id="&quot;CONGESTIVE HEART FAILURE&quot;">
