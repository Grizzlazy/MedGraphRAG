<node id="&quot;FEVER&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"A systemic symptom reported by the patient indicating an inflammatory or infectious state."</data>
  <data key="d2">chunk-81dbd4ebb0a9594a1876cd2e59a5c3a0</data>
  <data key="d3">[{"level": 0, "cluster": 2}]</data>
</node>
<node id="&quot;BACTERIA&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Pathogenic organism identified in the joint fluid culture, characterized by lack of maltose fermentation and polysaccharide capsule."</data>
  <data key="d2">chunk-81dbd4ebb0a9594a1876cd2e59a5c3a0</data>
  <data key="d3">[{"level": 0, "cluster": 2}]</data>
