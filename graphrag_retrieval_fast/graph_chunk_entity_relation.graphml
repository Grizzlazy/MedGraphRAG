<node id="&quot;SURGICAL OPERATION WITH ANASTOMOSIS, BYPASS, OR GRAFT, WITH NATURAL OR ARTIFICIAL TISSUES USED AS IMPLANT CAUSING ABNORMAL PATIENT REACTION, OR LATER COMPLICATION, WITHOUT MENTION OF MISADVENTURE AT TIME OF OPERATION&quot;">
  <data key="d0">"EVENT"</data>
